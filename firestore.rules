rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Presensi Harian collection
    match /presensi_harian/{tanggal} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(tanggal);
    }

    // Santri collection
    match /santri/{santriId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(santriId);
    }

    // Asatidz collection
    match /asatidz/{asatidzId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(asatidzId);
    }

    // Generic Menu records collection (used across the 18 views)
    match /menu_records/{recordId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(recordId);
    }

    // User accounts collection
    match /user_accounts/{userId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // Role permissions collection
    match /role_permissions/{roleKey} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(roleKey);
    }

    // App configurations & profiles (branding, sambutan, student_profile, teacher_profile, beranda)
    match /app_config/{configId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(configId);
    }

    // Tabungan Santri collection
    match /tabungan_santri/{tabunganId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(tabunganId);
    }

    // Raport Santri collection
    match /raport_santri/{raportId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(raportId);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

